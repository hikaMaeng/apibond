{
  "schema_version": 1,
  "listen": "0.0.0.0:18180",
  "inbound_auth": { "mode": "none" },
  "runtime": { "worker_threads": 8 },
  "routing": {
    "session_ttl_secs": 3600,
    "state_ttl_secs": 86400,
    "max_sessions_per_model": 10000,
    "max_state_entries": 100000,
    "strict_file_ownership": true,
    "user_id_fallback": false
  },
  "backends": {
    "qwen-28": {
      "base_url": "http://127.0.0.1:12345/v1",
      "apis": ["openai", "anthropic", "responses"],
      "capacity": 4,
      "cooldown_ms": 3000,
      "auth": { "scheme": "none" }
    },
    "qwen-tuf": {
      "base_url": "http://127.0.0.1:12345/v1",
      "apis": ["openai", "anthropic", "responses"],
      "capacity": 4,
      "cooldown_ms": 3000,
      "auth": { "scheme": "none" }
    }
  },
  "models": {
    "qwen36-35b": {
      "allow_raw": false,
      "backends": [
        { "backend": "qwen-28", "model": "qwen36-35b:28" },
        { "backend": "qwen-tuf", "model": "qwen36-35b:tuf" }
      ]
    }
  }
